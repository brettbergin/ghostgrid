<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>GhostGrid</string>
	<key>CFBundleIdentifier</key>
	<string>com.brettbergin.ghostgrid</string>
	<key>CFBundleName</key>
	<string>ghostgrid</string>
	<key>CFBundleDisplayName</key>
	<string>ghostgrid</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.2.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<!-- Folders: `gg <dir>` (open -a ghostgrid), or a folder dropped on the
	     Dock icon, opens a pane there. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Folder</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>None</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- The local model server (Explain failures) is plain HTTP on this Mac. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Programs run in a pane ask macOS through ghostgrid (and through
	     ghostgrid-sessiond, which gets these too; see bundle.sh). Paired
	     with Resources/ghostgrid.entitlements for release builds. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>A program running in ghostgrid wants to control another app.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>A program running in ghostgrid wants to use the microphone.</string>
	<key>NSCameraUsageDescription</key>
	<string>A program running in ghostgrid wants to use the camera.</string>
	<key>NSContactsUsageDescription</key>
	<string>A program running in ghostgrid wants to read your contacts.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>A program running in ghostgrid wants to read your calendars.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>A program running in ghostgrid wants to read your calendars.</string>
	<key>NSRemindersUsageDescription</key>
	<string>A program running in ghostgrid wants to read your reminders.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>A program running in ghostgrid wants to read your reminders.</string>
	<key>NSLocationUsageDescription</key>
	<string>A program running in ghostgrid wants to know your location.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>A program running in ghostgrid wants to read your photos.</string>
	<!-- In-app updates (Sparkle): the latest release's appcast, written by
	     Scripts/release.sh; updates must be signed with the release key,
	     whose private half is in the keychain of the Mac that releases. -->
	<key>SUFeedURL</key>
	<string>https://github.com/brettbergin/ghostgrid/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>J9ueevxZb0m419YYAc4dl7o/QkaIIHBBVNP3k+oXDcg=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
</dict>
</plist>
