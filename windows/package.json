{
  "name": "ghostgrid-windows",
  "private": true,
  "version": "0.3.1",
  "description": "ghostgrid for Windows: a terminal where each tab is an animated, auto-balanced grid of panes.",
  "type": "module",
  "scripts": {
    "prepare-native": "node scripts/prepare.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "typescript": "^5.9.0",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  }
}
